# Native local-development settings. Values are explicitly demo-only.
DJANGO_ENV=development
DJANGO_SECRET_KEY=dev-only-trainline-secret-key-do-not-use-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# SQLite keeps basic native development friction low. Use PostgreSQL for the
# integration tier because SQLite cannot prove locking/constraint behavior.
DATABASE_URL=sqlite:///db.sqlite3

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_LOG_LEVEL=INFO

# Local demo seeding is opt-in and is rejected in production.
ALLOW_DEMO_SEED=False
DEMO_USER_USERNAME=demo_traveler
DEMO_USER_EMAIL=demo.traveler@example.test
DEMO_USER_PASSWORD=Trainline-Demo-2026!

# API Documentation
SPECTACULAR_TITLE=Trainline API
SPECTACULAR_VERSION=1.0.0
