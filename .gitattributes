# Language classification
frontend/src/** linguist-vendored=false
*.js linguist-language=JavaScript
*.jsx linguist-language=JavaScript
*.css linguist-language=CSS
*.html linguist-language=HTML
*.sql linguist-language=SQL

# Container entrypoints must keep Unix line endings on Windows checkouts.
*.sh text eol=lf

# Documentation and generated/vendor content should not skew language totals.
docs/** linguist-documentation
*.png linguist-documentation
*.jpg linguist-documentation
*.jpeg linguist-documentation
*.gif linguist-documentation
*.mp4 linguist-documentation
frontend/build/** linguist-generated
backend/core/migrations/** linguist-generated
frontend/node_modules/** linguist-vendored
vendor/** linguist-vendored
