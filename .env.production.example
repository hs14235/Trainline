# Production Environment Variables Template
# Copy this file to .env and fill in secure values
# NEVER commit .env to git - it contains sensitive credentials

# =============================================================================
# SECURITY: Generate a new secret key for production
# Run: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# =============================================================================
DJANGO_SECRET_KEY=GENERATE-A-SECURE-RANDOM-KEY-HERE
DJANGO_ENV=production

# Debug mode - MUST be False in production
DJANGO_DEBUG=False
PAYMENT_MODE=demo
ALLOW_DEMO_SEED=False
ALLOW_DEPLOYMENT_DEMO_SEED=False

# Allowed hosts - comma-separated list of your domains
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Set these only as temporary hosting environment overrides while seeding a
# brand-new disposable demo database. Never commit the actual password.
DEMO_USER_USERNAME=choose-a-synthetic-demo-username
DEMO_USER_EMAIL=choose-a-synthetic-demo-user@example.test
DEMO_USER_PASSWORD=SET-A-SEPARATE-DEMO-LOGIN-PASSWORD

# =============================================================================
# DATABASE CREDENTIALS
# Use strong passwords (32+ characters, mix of alphanumeric and special chars)
# =============================================================================
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_DB=trainline_production

# API Base URL for frontend
REACT_APP_API_BASE=https://api.yourdomain.com
DJANGO_LOG_LEVEL=INFO
