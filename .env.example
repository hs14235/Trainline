# Docker Compose development defaults only. These values are intentionally
# non-sensitive and must never be reused for a deployed environment.
DJANGO_ENV=development
DJANGO_SECRET_KEY=dev-only-trainline-secret-key-do-not-use-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_USER=trainline_user
POSTGRES_PASSWORD=trainline_dev_password
POSTGRES_DB=trainline_db
POSTGRES_PORT=5432

REACT_APP_API_BASE=http://localhost:8000
DJANGO_LOG_LEVEL=INFO

# Local demo seeding is opt-in and is rejected in production.
ALLOW_DEMO_SEED=False
DEMO_USER_USERNAME=demo_traveler
DEMO_USER_EMAIL=demo.traveler@example.test
DEMO_USER_PASSWORD=Trainline-Demo-2026!
